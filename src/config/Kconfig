menu "Font"

choice
    prompt "Font source type"
    default COSCFG_FONT_TTF

config COSCFG_FONT_C_MULTI
    bool "C bitmap fonts (multi-size)"

config COSCFG_FONT_TTF
    bool "TrueType font (file system)"
endchoice

config COS_FONT_TYPE
    int
    default 0 if COSCFG_FONT_C_MULTI
    default 1 if COSCFG_FONT_TTF
    default 1

config COS_FONT_CFG_LARGE_SIZE
    int "Large font size (px)"
    default 30

config COS_FONT_CFG_MEDIUM_SIZE
    int "Medium font size (px)"
    default 26

config COS_FONT_CFG_SMALL_SIZE
    int "Small font size (px)"
    default 22

choice
    prompt "TTF data source"
    default COSCFG_FONT_TTF_FILE
    depends on COSCFG_FONT_TTF

config COSCFG_FONT_TTF_DATA
    bool "Compiled into firmware"

config COSCFG_FONT_TTF_FILE
    bool "Loaded from file system"
endchoice

config COS_FONT_TTF_TYPE
    int
    default 0 if COSCFG_FONT_TTF_DATA
    default 1 if COSCFG_FONT_TTF_FILE
    default 1

config COS_FONT_TTF_FILE_PATH
	string "TTF font file path"
	default "font.ttf"
	depends on COSCFG_FONT_TTF_FILE
	help
	  Path to the TrueType font file, relative to the system font
	  directory (COS_SYS_RES_FONT_DIR).  The final path is built as:
	    COS_SYS_RES_FONT_DIR + COS_FONT_TTF_FILE_PATH
	  e.g.  "/.sys/res/font/" + "font.ttf"  →  "/.sys/res/font/font.ttf".

	  On MCU (Flash / SD):
	    Default "font.ttf" is usually fine — the font is placed in the
	    same directory as other system resources.

	  On Native / WASM simulator:
	    The standard value "font.ttf" works out-of-the-box because the
	    CMake build automatically sets COS_SYS_ROOT_DIR to point at the
	    simulator's fs/ directory.

	  If you need a custom absolute path, override COS_FONT_TTF_FILE_PATH
	  via compiler flag (-D) — the Kconfig value is ignored when the
	  variable is already defined by the build system.

config COS_FONT_TTF_ENABLE_EXTENDED
	bool "Enable extended TTF features"
	default n
	depends on COSCFG_FONT_TTF
	help
	  Enables kerning adjustment and custom glyph cache size for
	  TrueType font rendering.

config COS_FONT_TTF_KERNING
	bool "Enable TTF kerning"
	default n
	depends on COS_FONT_TTF_ENABLE_EXTENDED

config COS_FONT_TTF_CACHE_SIZE
	int "TTF glyph cache size (entries)"
	default 256
	depends on COS_FONT_TTF_ENABLE_EXTENDED

endmenu

