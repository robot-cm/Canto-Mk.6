    bool "Custom (override cos_malloc_core etc.)"
endchoice

config COS_MEM_ALLOC_PROVIDER
    int
    default 0 if COSCFG_MEM_STDLIB
    default 1 if COSCFG_MEM_AUTO
    default 2 if COSCFG_MEM_CUSTOM
    default 0

config COS_MEM_POOL_ALLOC_THRESHOLD
    int "Pool allocation threshold (bytes)"
    default 32768
    depends on COSCFG_MEM_AUTO

config COS_OVERRIDE_LVGL_STDLIB_MALLOC_ENABLE
    bool "Override LVGL stdlib malloc with COS allocator"
    default y

config COS_MEM_TRACK_ENABLE
    bool "Enable memory tracking"
    default y

endmenu

menu "Image cache"

config COS_CACHE_ENABLE
    bool "Enable LVGL image decode cache"
    default y
    help
      When enabled, decoded image pixel data is cached to avoid
      re-decoding.  The cache is initialised during system startup.

      Disable this on platforms where the cache budget (COS_CACHE_SIZE)
      cannot accommodate the largest decoded image (e.g. high-resolution
      QR codes on a simulator with a 128 KB budget).

config COS_CACHE_SIZE
    int "Cache memory budget (bytes)"
    default 131072
    depends on COS_CACHE_ENABLE
    help
      Default: 128 KB.  If IMAGE_CACHE_IN_PSRAM_SIZE or
      IMAGE_CACHE_IN_SRAM_SIZE is defined, that value is used
      automatically.

config COS_CACHE_HEADER_COUNT
    int "Max cached image header entries"
    default 16
    depends on COS_CACHE_ENABLE

config COS_CACHE_USE_DEDICATED_MEM
	bool "Use dedicated memory pool for cache"
	default y if BSP_USING_PSRAM
	default y if IMAGE_CACHE_IN_PSRAM_SIZE
	default n
	depends on COS_CACHE_ENABLE

endmenu

